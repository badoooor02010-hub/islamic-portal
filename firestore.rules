rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // مشاركات الطالبات (أول متوسط): قراءة للجميع، إنشاء بدون تسجيل دخول
    // (مقيد بالتصنيفات الأربعة المعتمدة)، تعديل وحذف للمعلمة فقط
    match /posts/{post} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['studentName', 'grade', 'category', 'fileUrl', 'fileType',
           'fileName', 'chunked', 'fileSize', 'mime', 'createdAt'])
        && request.resource.data.grade == 'grade1'
        && request.resource.data.category in ['tawhid', 'tafsir', 'hadith', 'fiqh']
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 100;
      allow update, delete: if request.auth != null;

      // أجزاء الملفات الكبيرة (chunks) — قراءة للجميع، إنشاء عام مقيد
      match /chunks/{chunk} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['i', 'data'])
          && request.resource.data.i is number
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 1000000;
        allow update, delete: if request.auth != null;
      }
    }

    // استراتيجيات المعلمة: قراءة للجميع، كتابة للمعلمة فقط
    match /strategies/{doc} {
      allow read: if true;
      allow write: if request.auth != null;

      match /chunks/{chunk} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // استراتيجيات أنماط التعلم: قراءة للجميع، كتابة للمعلمة فقط
    match /learning_styles/{doc} {
      allow read: if true;
      allow write: if request.auth != null;

      match /chunks/{chunk} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
